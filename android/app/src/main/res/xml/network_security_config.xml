<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS everywhere, except plain HTTP for the SmarterASP test host (*.ctempurl.com) and the
     Android emulator's alias for the dev machine (10.0.2.2). Remove the domain-config once the
     server has a real HTTPS domain. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">ctempurl.com</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
