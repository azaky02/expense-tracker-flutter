# Copy to .env (never commit it). On SmarterASP the .env sits next to server.mjs.
PORT=4200
# postgres://USER:PASSWORD@HOST:5432/DATABASE   (URL-encode special characters in the password)
DATABASE_URL=postgres://masarefy@127.0.0.1:5433/masarefy
DB_SCHEMA=masarefy
AUTO_MIGRATE=on
JWT_ACCESS_SECRET=change-me-dev-access-secret-change-me
# open = anyone can register; code = needs SIGNUP_CODE; closed = nobody (existing users only)
REGISTRATION=open
SIGNUP_CODE=
CORS_ORIGIN=
